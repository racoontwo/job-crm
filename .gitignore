# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Atlas onboarding drops credentials here with a name that doesn't match
# .env* — ignore explicitly so it can never be committed by accident.
atlas-credentials.env

# Personal background used for cover-letter generation. Local-only: repo is public.
/profile

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database — your jobs. *.db-* also covers SQLite's -wal/-shm side files.
*.db
*.db-*
*.sqlite
*.sqlite3

# Anything personal or data-bearing stays local: the repo is public.
/logs
*.bak
*.backup
/backups
*.local
