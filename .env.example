# MongoDB Atlas (optional) — when set, the app reads/writes live data here
# instead of the local job-crm.db SQLite file. Leave unset for local-only use.
#
# Get this from the Atlas dashboard: Database > Connect > Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional — database name within the cluster. Defaults to "job-crm".
MONGODB_DB=job-crm

# Gemini API — powers AI-drafted cover letters. Without it, everything else
# still works; only the "Generate cover letter" button needs it.
# Free tier is plenty for personal use. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the model. Defaults to gemini-2.5-flash.
# gemini-2.5-pro gives better prose at a lower free-tier quota.
GEMINI_MODEL=gemini-2.5-flash

# Network binding for `npm run dev` / `npm run start`. Defaults to 127.0.0.1 so
# nothing on the local network (e.g. public wifi) can reach the app. Not read
# from this file — pass it on the command line only when you deliberately want
# to expose it, e.g. to a Tailscale IP: `BIND_HOST=100.x.y.z npm run dev`.
# Never use 0.0.0.0.
# BIND_HOST=127.0.0.1
